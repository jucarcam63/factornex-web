# Copia este archivo como .env y rellena los valores. .env no se sube a GitHub.
# En Vercel, las mismas variables se añaden en Settings → Environment Variables.

# NIF del titular: solo se usa en el aviso legal, nunca en el pie ni en otras páginas.
NIF_TITULAR=

# Formulario de contacto (Resend). Sin RESEND_API_KEY o CONTACT_TO_EMAIL, en local no se envía nada
# (el mensaje se muestra en la consola del servidor); en producción el formulario avisa de que no está disponible.
# Clave API de Resend (tipo "Sending access"). NUNCA en el código ni en el chat.
RESEND_API_KEY=
# Correo que recibe las consultas.
CONTACT_TO_EMAIL=
# Remitente. Opcional. Sin dominio verificado en Resend se usa onboarding@resend.dev (solo envía al correo de la cuenta de Resend).
CONTACT_FROM_EMAIL=
