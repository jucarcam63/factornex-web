---
// Inicio. Orden de secciones y textos: docs/CONTENIDOS.md. Textos marcados [BORRADOR] en el documento.
import Base from '../layouts/Base.astro';
import Seccion from '../components/Seccion.astro';
import Hero from '../components/Hero.astro';
import ChatDemo from '../components/ChatDemo.astro';
import Pasos from '../components/Pasos.astro';
import Faq from '../components/Faq.astro';
import Tarjeta from '../components/Tarjeta.astro';
import Boton from '../components/Boton.astro';
import { RESERVA_URL, SITE } from '../config';
import { pasosHistoria, preguntasComunes, integraciones, notaIntegraciones } from '../contenidos/agente';

---
<Base titulo={`${SITE.nombre} — ${SITE.descriptor}`} descripcion="Agente de IA que atiende el WhatsApp y las llamadas de tu negocio: responde, presupuesta, agenda citas y avisa. Para pymes, autónomos y comercios.">
  <Hero
    etiqueta="Agente de IA para WhatsApp y llamadas"
    titulo="Que ninguna llamada ni mensaje de tu negocio se quede sin respuesta."
    subtitulo="Un agente de IA atiende tu WhatsApp y tus llamadas a cualquier hora: responde, presupuesta según tus tarifas, agenda la cita y te avisa. Si no sabe algo, pasa el caso a una persona."
    principal={{ texto: 'Reservar una llamada', href: RESERVA_URL }}
    secundario={{ texto: 'Ver cómo funciona', href: '#como-funciona' }}
  >
    <ChatDemo />
  </Hero>

  <Seccion fondo="claro" id="problema" titulo="¿Cuántos clientes se pierden por no contestar a tiempo?" introduccion="Atender bien también significa estar disponible cuando el cliente pregunta.">
    <div class="grid gap-6 md:grid-cols-3">
      <Tarjeta titulo="Llamadas que no se cogen">Mientras atiendes a un cliente o estás fuera, suena el teléfono y nadie contesta.</Tarjeta>
      <Tarjeta titulo="Mensajes fuera de horario">Quien escribe por la noche o en fin de semana espera una respuesta. Si no llega, puede acudir a otro negocio.</Tarjeta>
      <Tarjeta titulo="Respuestas que llevan tiempo">Contestar a mano, preguntando tarifas y huecos uno a uno, te quita tiempo de lo que de verdad sabes hacer.</Tarjeta>
    </div>
  </Seccion>

  <Seccion id="como-funciona" titulo="Cómo funciona, con un ejemplo" introduccion="Así sería un domingo por la tarde en un negocio con el agente funcionando.">
    <Pasos pasos={pasosHistoria} />
  </Seccion>

  <Seccion fondo="claro" id="que-hace" titulo="Un empleado que nunca cierra" introduccion="El agente es como una persona más de tu equipo, con sus tareas claras.">
    <dl class="grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-borde bg-superficie p-6">
        <dt class="font-titulos text-lg font-bold">Canales</dt>
        <dd class="mt-2 text-suave">WhatsApp y llamadas.</dd>
      </div>
      <div class="rounded-2xl border border-borde bg-superficie p-6">
        <dt class="font-titulos text-lg font-bold">Horario</dt>
        <dd class="mt-2 text-suave">Las 24 horas, todos los días.</dd>
      </div>
      <div class="rounded-2xl border border-borde bg-superficie p-6">
        <dt class="font-titulos text-lg font-bold">Qué hace</dt>
        <dd class="mt-2 text-suave">Responde dudas, presupuesta según tus tarifas, agenda citas, envía recordatorios y avisa a tu equipo.</dd>
      </div>
      <div class="rounded-2xl border border-borde bg-superficie p-6">
        <dt class="font-titulos text-lg font-bold">Cuando no sabe</dt>
        <dd class="mt-2 text-suave">Pasa el caso a una persona. Y siempre dice que es una IA.</dd>
      </div>
    </dl>
  </Seccion>

  <Seccion id="integraciones" titulo="Se conecta con lo que ya usas" introduccion="El agente trabaja con tus herramientas del día a día, por ejemplo para ver tus huecos y reservar citas en tu calendario.">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {integraciones.map((i) => <Tarjeta titulo={i.titulo}>{i.texto}</Tarjeta>)}
    </div>
    <p class="mt-8 text-suave">{notaIntegraciones}</p>
  </Seccion>

  <Seccion fondo="claro" id="mas-servicios" titulo="Y si necesitas algo más" introduccion="Además del agente, creamos soluciones a medida para el resto de tu negocio.">
    <div class="grid gap-6 md:grid-cols-2">
      <Tarjeta titulo="Automatización de procesos" href="/servicios">Tareas administrativas, conexión entre herramientas, avisos y seguimiento comercial, sin repetir el trabajo a mano.</Tarjeta>
      <Tarjeta titulo="Desarrollo a medida" href="/servicios">Aplicaciones web, paneles de control y herramientas de gestión, con el diseño incluido.</Tarjeta>
    </div>
  </Seccion>

  <Seccion id="preguntas" titulo="Preguntas frecuentes">
    <Faq preguntas={preguntasComunes} />
  </Seccion>

  <Seccion fondo="noche" id="reserva" titulo="Hablemos de tu negocio" introduccion="Reserva una llamada de diagnóstico gratuito y te contamos cómo encajaría un agente en tu día a día.">
    <Boton href={RESERVA_URL} variante="negativo">Reservar una llamada</Boton>
  </Seccion>
</Base>
