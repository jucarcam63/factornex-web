---
// Página TEMPORAL para revisar los componentes base. Retirar antes de publicar (Fase 3).
import Base from '../layouts/Base.astro';
import Seccion from '../components/Seccion.astro';
import Boton from '../components/Boton.astro';
import Tarjeta from '../components/Tarjeta.astro';

const colores = [
  ['noche', '#0A2E62', 'bg-noche'],
  ['intenso', '#0D2F9B', 'bg-intenso'],
  ['real', '#0C4AA5', 'bg-real'],
  ['medio', '#0B7BBB', 'bg-medio'],
  ['cielo', '#16A4CE', 'bg-cielo'],
  ['turquesa', '#2ACED7', 'bg-turquesa'],
  ['pizarra', '#6B6B6B', 'bg-pizarra'],
  ['claro', '#F2F5F8', 'bg-claro border border-noche/20'],
];
---
<Base titulo="Guía de estilo" descripcion="Página interna de revisión de componentes." noindex>
  <Seccion id="tipografia" titulo="Guía de estilo (temporal)" introduccion="Página interna para revisar colores, tipografías y componentes base. No se publica.">
    <h1 class="text-4xl sm:text-5xl">Titular H1 en Manrope</h1>
    <h2 class="mt-4 text-3xl">Titular H2 en Manrope</h2>
    <h3 class="mt-4 text-xl">Titular H3 en Manrope</h3>
    <p class="mt-4 max-w-2xl">Texto de párrafo en Inter. La tecnología debe trabajar para tu negocio. <a href="#tipografia" class="text-medio underline underline-offset-4">Enlace de ejemplo</a>.</p>
    <p class="mt-2 text-pizarra">Texto secundario en gris pizarra.</p>
  </Seccion>

  <Seccion fondo="claro" id="colores" titulo="Colores">
    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      {colores.map(([nombre, hex, clase]) => (
        <li>
          <div class={`h-16 rounded-lg ${clase}`}></div>
          <p class="mt-2 text-sm font-semibold">{nombre}</p>
          <p class="text-sm text-pizarra">{hex}</p>
        </li>
      ))}
    </ul>
  </Seccion>

  <Seccion id="botones" titulo="Botones">
    <div class="flex flex-wrap gap-4">
      <Boton href="#botones">Principal</Boton>
      <Boton href="#botones" variante="secundario">Secundario</Boton>
      <div class="rounded-lg bg-noche p-3"><Boton href="#botones" variante="negativo">Negativo</Boton></div>
    </div>
  </Seccion>

  <Seccion fondo="claro" id="tarjetas" titulo="Tarjetas">
    <div class="grid gap-6 md:grid-cols-3">
      <Tarjeta titulo="Tarjeta informativa">Texto de ejemplo de una tarjeta sin enlace.</Tarjeta>
      <Tarjeta titulo="Tarjeta con enlace" href="#tarjetas">Esta tarjeta entera es un enlace.</Tarjeta>
      <Tarjeta titulo="Otra tarjeta">Texto de ejemplo.</Tarjeta>
    </div>
  </Seccion>

  <Seccion fondo="noche" id="noche" titulo="Sección azul noche" introduccion="Texto introductorio sobre fondo azul noche.">
    <Boton href="#noche" variante="negativo">Botón negativo</Boton>
  </Seccion>

  <Seccion fondo="degradado" id="degradado" titulo="Sección con degradado" introduccion="Degradado de azul intenso a turquesa.">
    <Boton href="#degradado" variante="negativo">Botón negativo</Boton>
  </Seccion>
</Base>
