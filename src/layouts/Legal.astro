---
// Plantilla de las páginas legales: título, fecha de actualización y texto largo legible.
import Base from './Base.astro';
import Contenedor from '../components/Contenedor.astro';
import { LEGAL_ACTUALIZADO } from '../config';
interface Props {
  titulo: string;
  descripcion: string;
}
const { titulo, descripcion } = Astro.props;
---
<Base titulo={titulo} descripcion={descripcion}>
  <section class="py-14 sm:py-20">
    <Contenedor>
      <article class="mx-auto max-w-3xl">
        <h1 class="text-4xl sm:text-5xl">{titulo}</h1>
        <p class="mt-3 text-sm text-suave">Última actualización: {LEGAL_ACTUALIZADO}</p>
        <div class="texto-legal mt-8">
          <slot />
        </div>
      </article>
    </Contenedor>
  </section>
</Base>
