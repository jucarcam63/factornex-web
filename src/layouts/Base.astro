---
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { SITE } from '../config';

interface Props {
  titulo: string;
  descripcion: string;
  noindex?: boolean;
}
const { titulo, descripcion, noindex = false } = Astro.props;
const urlCanonica = new URL(Astro.url.pathname, SITE.url).href;
const tituloCompleto = titulo.includes(SITE.nombre) ? titulo : `${titulo} | ${SITE.nombre}`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlCanonica} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonica} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#050E24" />
  </head>
  <body class="min-h-screen bg-fondo text-texto antialiased">
    <Cabecera />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
  </body>
</html>
