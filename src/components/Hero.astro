---
import Contenedor from './Contenedor.astro';
import Boton from './Boton.astro';
interface Props {
  etiqueta?: string;
  titulo: string;
  subtitulo: string;
  principal: { texto: string; href: string };
  secundario?: { texto: string; href: string };
}
const { etiqueta, titulo, subtitulo, principal, secundario } = Astro.props;
---
<section class="bg-white py-14 sm:py-20" aria-labelledby="hero-titulo">
  <Contenedor class="grid items-center gap-12 lg:grid-cols-2">
    <div>
      {etiqueta && (
        <p class="mb-4 inline-block rounded-full bg-claro px-3 py-1 text-sm font-semibold text-medio">{etiqueta}</p>
      )}
      <h1 id="hero-titulo" class="text-4xl sm:text-5xl">{titulo}</h1>
      <p class="mt-5 max-w-xl text-lg text-pizarra">{subtitulo}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Boton href={principal.href}>{principal.texto}</Boton>
        {secundario && <Boton href={secundario.href} variante="secundario">{secundario.texto}</Boton>}
      </div>
    </div>
    <div>
      <slot />
    </div>
  </Contenedor>
</section>
