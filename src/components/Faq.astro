---
interface Props {
  preguntas: { pregunta: string; respuesta: string }[];
}
const { preguntas } = Astro.props;
---
<div class="borde-degradado max-w-3xl divide-y divide-borde overflow-hidden rounded-2xl">
  {preguntas.map((p) => (
    <details class="group transition-colors duration-200 hover:bg-white/5 open:bg-white/5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-titulos text-lg font-semibold text-texto transition-colors hover:text-turquesa [&::-webkit-details-marker]:hidden">
        {p.pregunta}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-turquesa transition-transform group-open:rotate-180" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
      </summary>
      <p class="px-5 pb-5 text-suave">{p.respuesta}</p>
    </details>
  ))}
</div>
