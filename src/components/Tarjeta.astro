---
interface Props {
  titulo: string;
  href?: string;
  class?: string;
}
const { titulo, href, class: clase = '' } = Astro.props;
const Etiqueta = href ? 'a' : 'div';
---
<Etiqueta
  href={href}
  class:list={[
    'block rounded-2xl border border-borde bg-superficie p-6 text-texto',
    href && 'transition hover:-translate-y-0.5 hover:border-turquesa hover:bg-superficie-2',
    clase,
  ]}
>
  <h3 class="text-xl">{titulo}</h3>
  <div class="mt-3 text-suave"><slot /></div>
</Etiqueta>
