---
interface Props {
  titulo: string;
  href?: string;
  class?: string;
  /** Nivel del encabezado de la tarjeta: h3 por defecto (dentro de una sección con h2). Usar h2 si la tarjeta cuelga directamente del h1. */
  nivel?: 'h2' | 'h3';
}
const { titulo, href, class: clase = '', nivel = 'h3' } = Astro.props;
const Etiqueta = href ? 'a' : 'div';
const Encabezado = nivel;
---
<Etiqueta
  href={href}
  class:list={['borde-degradado tarjeta-interactiva block rounded-2xl p-6 text-texto', clase]}
>
  <Encabezado class="text-xl">{titulo}</Encabezado>
  <div class="mt-3 text-suave"><slot /></div>
</Etiqueta>
