---
interface Props {
  titulo: string;
  href?: string;
  class?: string;
}
const { titulo, href, class: clase = '' } = Astro.props;
const Etiqueta = href ? 'a' : 'div';
---
<Etiqueta
  href={href}
  class:list={[
    'block rounded-2xl border border-noche/10 bg-white p-6 text-noche shadow-sm',
    href && 'transition hover:-translate-y-0.5 hover:border-medio hover:shadow-md',
    clase,
  ]}
>
  <h3 class="text-xl">{titulo}</h3>
  <div class="mt-3 text-pizarra"><slot /></div>
</Etiqueta>
