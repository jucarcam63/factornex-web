---
// Maqueta de conversación de ejemplo (negocio ficticio) dentro de un móvil tipo Android.
// No es un caso real ni usa cifras. Los mensajes salen uno a uno cuando el móvil entra en pantalla.
const mensajes = [
  { de: 'cliente', hora: '16:32', texto: 'Hola, ¿tenéis hueco esta semana para corte y tinte?' },
  { de: 'agente', hora: '16:32', texto: '¡Hola! Soy Lucía, la asistente virtual de Peluquería Ejemplo (una IA). Sí, te ayudo. ¿Tienes preferencia de día y hora?' },
  { de: 'cliente', hora: '16:33', texto: 'El jueves por la tarde.' },
  { de: 'agente', hora: '16:33', texto: 'Corte y tinte según las tarifas del negocio. Tengo libre el jueves a las 17:00. ¿Te lo reservo?' },
  { de: 'cliente', hora: '16:34', texto: 'Sí, por favor.' },
  { de: 'agente', hora: '16:34', texto: 'Hecho: jueves a las 17:00. Te enviaré un recordatorio el día antes.' },
];
// Cada paso se enciende cuando sale el mensaje indicado (posición en la lista de mensajes).
const pasos = [
  { texto: 'Consulta entendida', tras: 1 },
  { texto: 'Presupuesto', tras: 3 },
  { texto: 'Cita agendada', tras: 5 },
];
---
<figure class="cd mx-auto w-full max-w-[19rem] sm:max-w-[20rem]" aria-labelledby="chat-leyenda" data-chat>
  <!-- Carcasa del móvil -->
  <div class="rounded-[2.6rem] border-[3px] border-[#2b3a55] bg-[#05080f] p-[9px] shadow-2xl shadow-black/50">
    <div class="relative flex h-[32rem] flex-col overflow-hidden rounded-[2rem] bg-[#0b141a]">
      <!-- Barra de estado -->
      <div class="flex items-center justify-between bg-[#1f2c34] px-5 pb-1 pt-2 text-[11px] font-medium text-[#e9edef]" aria-hidden="true">
        <span>16:34</span>
        <span class="absolute left-1/2 top-2 h-2.5 w-2.5 -translate-x-1/2 rounded-full bg-[#05080f]"></span>
        <span class="flex items-center gap-1.5">
          <!-- Cobertura -->
          <svg width="14" height="12" viewBox="0 0 14 12" fill="currentColor"><rect x="0" y="8" width="2.5" height="4" rx="0.6" /><rect x="4" y="5.5" width="2.5" height="6.5" rx="0.6" /><rect x="8" y="3" width="2.5" height="9" rx="0.6" /><rect x="12" y="0" width="2" height="12" rx="0.6" opacity="0.35" /></svg>
          <!-- Wifi -->
          <svg width="14" height="12" viewBox="0 0 24 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M2 7a15 15 0 0 1 20 0" /><path d="M6 11.5a9 9 0 0 1 12 0" /><path d="M10 16a3 3 0 0 1 4 0" /></svg>
          <!-- Batería -->
          <svg width="22" height="11" viewBox="0 0 26 12" fill="none"><rect x="0.7" y="0.7" width="21" height="10.6" rx="2.6" stroke="currentColor" stroke-width="1.4" opacity="0.7" /><rect x="2.4" y="2.4" width="14" height="7.2" rx="1.4" fill="currentColor" /><rect x="23" y="3.8" width="2" height="4.4" rx="1" fill="currentColor" opacity="0.7" /></svg>
        </span>
      </div>

      <!-- Cabecera de la conversación -->
      <div class="flex items-center gap-2 bg-[#1f2c34] px-2 py-2 text-[#e9edef]">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-turquesa font-titulos text-xs font-bold text-noche" aria-hidden="true">PE</span>
        <div class="min-w-0 flex-1 leading-tight">
          <p class="truncate font-titulos text-sm font-semibold">Peluquería Ejemplo</p>
          <p class="truncate text-[11px] text-[#8fa3ad]">Atendido por Lucía, agente de IA</p>
        </div>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" /></svg>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.8" /><circle cx="12" cy="12" r="1.8" /><circle cx="12" cy="19" r="1.8" /></svg>
      </div>

      <!-- Mensajes (anclados abajo; los más antiguos suben) -->
      <ol class="cd-lista flex flex-1 flex-col justify-end gap-2 overflow-hidden px-3 py-3" aria-label="Conversación de ejemplo">
        <li class="mx-auto mb-1 rounded-lg bg-[#1f2c34] px-3 py-1 text-[10px] uppercase tracking-wide text-[#8fa3ad]" aria-hidden="true">Hoy</li>
        {mensajes.map((m) => (
          <li class:list={['cd-msg flex', m.de === 'cliente' ? 'justify-start' : 'justify-end']}>
            <p
              class:list={[
                'max-w-[85%] rounded-lg px-2.5 py-1.5 text-[13px] leading-snug text-[#e9edef] shadow-sm',
                m.de === 'cliente' ? 'rounded-tl-none bg-[#202c33]' : 'rounded-tr-none bg-[#005c4b]',
              ]}
            >
              <span class="sr-only">{m.de === 'cliente' ? 'Cliente: ' : 'Agente: '}</span>{m.texto}
              <span class="mt-0.5 flex items-center justify-end gap-1 text-[10px] text-[#8fa3ad]" aria-hidden="true">
                {m.hora}
                {m.de === 'agente' && (
                  <svg width="15" height="10" viewBox="0 0 18 11" fill="none" stroke="#53bdeb" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M1 5.8l3.2 3.2L10.5 1.5" /><path d="M7 8.6l.4.4L13.7 1.5" /></svg>
                )}
              </span>
            </p>
          </li>
        ))}
      </ol>

      <!-- Barra de escribir -->
      <div class="flex items-center gap-2 px-2 pb-2 pt-1" aria-hidden="true">
        <div class="flex flex-1 items-center gap-2 rounded-full bg-[#1f2c34] px-3 py-2 text-[12px] text-[#8fa3ad]">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M8.5 14.5a4.5 4.5 0 0 0 7 0" /><path d="M9 9.5h.01M15 9.5h.01" /></svg>
          <span class="flex-1">Mensaje</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.5l-8.6 8.6a5.5 5.5 0 0 1-7.8-7.8l8.6-8.6a3.7 3.7 0 0 1 5.2 5.2l-8.7 8.6a1.8 1.8 0 0 1-2.6-2.6l8-8" /></svg>
        </div>
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#00a884] text-[#0b141a]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="12" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg>
        </span>
      </div>

      <!-- Barra de gestos de Android -->
      <div class="flex justify-center pb-1.5" aria-hidden="true"><span class="h-1 w-24 rounded-full bg-[#e9edef]/60"></span></div>
    </div>
  </div>

  <ul class="mt-4 flex flex-wrap justify-center gap-2">
    {pasos.map((p) => (
      <li class="cd-paso inline-flex items-center gap-1.5 rounded-full border border-borde bg-superficie px-3 py-1 text-xs font-medium text-texto" data-tras={p.tras}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-turquesa" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>
        {p.texto}
      </li>
    ))}
  </ul>
  <figcaption id="chat-leyenda" class="mt-3 text-center text-sm text-suave">
    Ejemplo ilustrativo con un negocio ficticio. No es un caso real.
  </figcaption>
</figure>

<noscript><style>.cd-msg, .cd-paso { display: flex !important; }</style></noscript>

<style is:global>
  /* Con movimiento permitido, los mensajes y pasos empiezan ocultos y los muestra el script uno a uno.
     Sin JavaScript (noscript) o con "reducir movimiento" se ven todos desde el principio. */
  @media (prefers-reduced-motion: no-preference) {
    .cd-msg:not(.cd-visto), .cd-paso:not(.cd-visto) { display: none; }
    .cd-msg.cd-visto { animation: cd-entra 0.35s ease both; }
    .cd-paso.cd-visto { animation: cd-entra 0.4s ease both; }
  }
  @keyframes cd-entra {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }
  /* Indicador "escribiendo…" */
  .cd-escribiendo { display: flex; justify-content: flex-end; }
  .cd-escribiendo span.cd-burbuja {
    display: inline-flex; gap: 4px; align-items: center; padding: 0.7rem 0.8rem;
    border-radius: 0.5rem; border-top-right-radius: 0; background: #005c4b;
  }
  .cd-escribiendo i {
    width: 6px; height: 6px; border-radius: 9999px; background: #8fa3ad; display: block;
    animation: cd-punto 1s infinite ease-in-out;
  }
  .cd-escribiendo i:nth-child(2) { animation-delay: 0.15s; }
  .cd-escribiendo i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes cd-punto {
    0%, 80%, 100% { opacity: 0.35; transform: translateY(0); }
    40% { opacity: 1; transform: translateY(-3px); }
  }
</style>

<script>
  // Reproduce la conversación una sola vez, cuando el móvil se ve en pantalla.
  const espera = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

  async function reproducir(fig: HTMLElement) {
    const mensajes = Array.from(fig.querySelectorAll<HTMLElement>('.cd-msg'));
    const pasos = Array.from(fig.querySelectorAll<HTMLElement>('.cd-paso'));
    await espera(600);
    for (let i = 0; i < mensajes.length; i++) {
      const msg = mensajes[i];
      const agente = msg.classList.contains('justify-end');
      if (agente) {
        const escribiendo = document.createElement('li');
        escribiendo.className = 'cd-escribiendo';
        escribiendo.setAttribute('aria-hidden', 'true');
        escribiendo.innerHTML = '<span class="cd-burbuja"><i></i><i></i><i></i></span>';
        msg.before(escribiendo);
        await espera(1400);
        escribiendo.remove();
      } else {
        await espera(1000);
      }
      msg.classList.add('cd-visto');
      pasos.filter((p) => Number(p.dataset.tras) === i).forEach((p) => p.classList.add('cd-visto'));
      await espera(900);
    }
  }

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const figuras = document.querySelectorAll<HTMLElement>('[data-chat]');
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            observador.unobserve(e.target);
            reproducir(e.target as HTMLElement);
          }
        }
      },
      { threshold: 0.5 },
    );
    figuras.forEach((f) => observador.observe(f));
  }
</script>
