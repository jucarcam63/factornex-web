---
// Logo provisional (PNG recortado de los márgenes; el símbolo no se modifica).
// Cuando existan los SVG definitivos (docs/MARCA.md), cambiar LOGO en src/config.ts.
import { LOGO } from '../config';
interface Props { class?: string }
const { class: clase = '' } = Astro.props;
---
<img
  src={LOGO.src}
  alt={LOGO.alt}
  width={LOGO.ancho}
  height={LOGO.alto}
  class:list={['block w-auto', clase]}
/>
