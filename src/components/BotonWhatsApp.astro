---
// Botón flotante de WhatsApp. Solo se pinta si hay número de empresa (WHATSAPP_NUMERO en src/config.ts).
// Es un enlace normal a wa.me: no carga scripts de terceros ni usa cookies.
import { WHATSAPP_URL } from '../config';
---
{WHATSAPP_URL && (
  <a
    href={WHATSAPP_URL}
    target="_blank"
    rel="noopener"
    aria-label="Escríbenos por WhatsApp (se abre en una pestaña nueva)"
    class="fixed bottom-4 right-4 z-40 inline-flex h-14 items-center justify-center gap-2 rounded-full bg-turquesa px-4 font-titulos font-semibold text-noche shadow-lg shadow-black/40 transition-all duration-200 hover:-translate-y-0.5 hover:bg-white motion-reduce:transition-none motion-reduce:hover:transform-none sm:bottom-6 sm:right-6 sm:px-5"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.7-5.2A8.5 8.5 0 1 1 21 11.5Z" />
    </svg>
    <span class="hidden sm:inline">WhatsApp</span>
  </a>
)}
