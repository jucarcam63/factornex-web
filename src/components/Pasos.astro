---
interface Props {
  pasos: { titulo: string; texto: string }[];
}
const { pasos } = Astro.props;
const columnas = pasos.length === 4 ? 'md:grid-cols-4' : 'md:grid-cols-5';
---
<ol class:list={['grid gap-6', columnas]}>
  {pasos.map((p, i) => (
    <li class="borde-degradado tarjeta-interactiva relative rounded-2xl p-5">
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-medio to-turquesa font-titulos font-bold text-noche" aria-hidden="true">{i + 1}</span>
      <h3 class="mt-4 text-lg text-texto"><span class="sr-only">Paso {i + 1}: </span>{p.titulo}</h3>
      <p class="mt-2 text-sm text-suave">{p.texto}</p>
    </li>
  ))}
</ol>
