---
interface Props {
  href: string;
  variante?: 'principal' | 'secundario' | 'negativo';
  class?: string;
}
const { href, variante = 'principal', class: clase = '' } = Astro.props;
// Tema oscuro: principal con degradado azul (blanco ≥ 4,6:1); al pasar el ratón se ilumina en turquesa (azul noche 6,9:1).
// Secundario con borde degradado. Todos suben y brillan al pasar el ratón.
const estilos = {
  principal:
    'bg-gradient-to-r from-real to-medio text-white shadow-lg shadow-medio/30 hover:-translate-y-0.5 hover:bg-none hover:bg-turquesa hover:text-noche hover:shadow-[0_10px_28px_-6px_rgba(42,206,215,0.6)]',
  secundario: 'boton-borde text-texto',
  negativo:
    'bg-white text-noche shadow-lg shadow-black/20 hover:-translate-y-0.5 hover:bg-turquesa hover:shadow-[0_10px_28px_-6px_rgba(42,206,215,0.6)]',
};
---
<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center rounded-lg px-6 py-3 font-titulos font-semibold transition-all duration-200 motion-reduce:transition-none motion-reduce:hover:transform-none',
    estilos[variante],
    clase,
  ]}
>
  <slot />
</a>
