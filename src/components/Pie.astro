---
import Contenedor from './Contenedor.astro';
import { MENU, LEGALES, EMPRESA, SITE } from '../config';
const anio = new Date().getFullYear();
---
<footer class="bg-noche text-white">
  <Contenedor class="grid gap-10 py-14 md:grid-cols-3">
    <div>
      {/* Hueco con el nombre como texto: el logo negativo (blanco) aún no existe. Ver docs/MARCA.md */}
      <p class="font-titulos text-2xl font-bold tracking-wide">{SITE.nombre}</p>
      <p class="mt-2 text-white/80">{SITE.descriptor}</p>
      <p class="mt-1 text-white/80">{SITE.eslogan}</p>
    </div>

    <nav aria-label="Pie de página">
      <h2 class="font-titulos text-base font-semibold">Navegación</h2>
      <ul class="mt-3 space-y-2">
        {MENU.map((e) => (
          <li><a href={e.href} class="text-white/80 underline-offset-4 hover:text-turquesa hover:underline">{e.texto}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="font-titulos text-base font-semibold">Titular</h2>
      <address class="mt-3 space-y-1 not-italic text-white/80">
        <p>{EMPRESA.titular} · {EMPRESA.nombreComercial}</p>
        <p>NIF: {EMPRESA.nif}</p>
        <p>{EMPRESA.domicilio}</p>
        <p>{EMPRESA.correo}</p>
      </address>
    </div>
  </Contenedor>

  <div class="border-t border-white/15">
    <Contenedor class="flex flex-col gap-3 py-5 text-sm text-white/80 sm:flex-row sm:items-center sm:justify-between">
      <p>© {anio} {EMPRESA.nombreComercial}. Todos los derechos reservados.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {LEGALES.map((e) => (
          <li><a href={e.href} class="underline-offset-4 hover:text-turquesa hover:underline">{e.texto}</a></li>
        ))}
      </ul>
    </Contenedor>
  </div>
</footer>
