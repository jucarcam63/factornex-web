---
import Contenedor from './Contenedor.astro';
import Logo from './Logo.astro';
import { MENU, LEGALES, EMPRESA, SITE } from '../config';
const anio = new Date().getFullYear();
---
<footer class="border-t border-borde bg-[#030a1a] text-white">
  <Contenedor class="grid gap-10 py-14 md:grid-cols-3">
    <div>
      <a href="/" aria-label={`${SITE.nombre}, ir al inicio`} class="inline-block">
        <Logo class="h-14" />
      </a>
      <p class="mt-4 text-white/80">{SITE.descriptor}</p>
      <p class="mt-1 text-white/80">{SITE.eslogan}</p>
    </div>

    <nav aria-label="Pie de página">
      <h2 class="font-titulos text-base font-semibold">Navegación</h2>
      <ul class="mt-3 space-y-2">
        {MENU.map((e) => (
          <li><a href={e.href} class="inline-block text-white/80 underline-offset-4 transition duration-200 hover:translate-x-1 hover:text-turquesa hover:underline motion-reduce:transition-none motion-reduce:hover:transform-none">{e.texto}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="font-titulos text-base font-semibold">Titular</h2>
      <address class="mt-3 space-y-1 not-italic text-white/80">
        <p>{EMPRESA.nombreComercial} · {EMPRESA.titular}</p>
        <p><a href="/contacto#formulario" class="underline underline-offset-4 hover:text-turquesa">Escríbenos desde el formulario</a></p>
      </address>
    </div>
  </Contenedor>

  <div class="border-t border-borde">
    <Contenedor class="flex flex-col gap-3 py-5 text-sm text-white/80 sm:flex-row sm:items-center sm:justify-between">
      <p>© {anio} {EMPRESA.nombreComercial}. Todos los derechos reservados.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {LEGALES.map((e) => (
          <li><a href={e.href} class="inline-block underline-offset-4 transition duration-200 hover:-translate-y-0.5 hover:text-turquesa hover:underline motion-reduce:transition-none motion-reduce:hover:transform-none">{e.texto}</a></li>
        ))}
      </ul>
    </Contenedor>
  </div>
</footer>
