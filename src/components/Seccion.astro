---
import Contenedor from './Contenedor.astro';
interface Props {
  fondo?: 'blanco' | 'claro' | 'noche' | 'degradado';
  id?: string;
  titulo?: string;
  introduccion?: string;
  class?: string;
}
const { fondo = 'blanco', id, titulo, introduccion, class: clase = '' } = Astro.props;
// Tema oscuro: 'blanco' = fondo base, 'claro' = banda alternada, 'noche' = banda de cierre con degradado
// azul (texto blanco con buen contraste), 'degradado' = degradado completo (cuidado con el turquesa).
const fondos = {
  blanco: 'text-texto',
  claro: 'bg-white/[0.04] text-texto',
  noche: 'bg-gradient-to-br from-intenso via-real to-medio text-white',
  degradado: 'bg-gradient-to-br from-intenso via-medio to-turquesa text-white',
};
const destacado = fondo === 'noche' || fondo === 'degradado';
---
<section id={id} class:list={['py-16 sm:py-24', fondos[fondo], clase]} aria-labelledby={titulo && id ? `${id}-titulo` : undefined}>
  <Contenedor>
    {(titulo || introduccion) && (
      <header class="mb-10 max-w-3xl sm:mb-14">
        {titulo && <h2 id={id ? `${id}-titulo` : undefined} class="text-3xl sm:text-4xl">{titulo}</h2>}
        {introduccion && <p class:list={['mt-4 text-lg', destacado ? 'text-white/90' : 'text-suave']}>{introduccion}</p>}
      </header>
    )}
    <slot />
  </Contenedor>
</section>
